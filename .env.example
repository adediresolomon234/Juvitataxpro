# Copy to ".env.local" and fill in. Required for the contact form to email the PDF.
# Works with any SMTP provider (Gmail App Password, your host's mailbox, Resend SMTP, etc.)

SMTP_HOST=smtp.yourhost.com
SMTP_PORT=587
SMTP_SECURE=false           # "true" for port 465, "false" for 587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-smtp-password-or-app-password

CONTACT_FROM="Juvida Tax Pro <no-reply@yourdomain.com>"
CONTACT_TO=sales@yourdomain.com   # where demo requests + the PDF are delivered

# --- Gated download (one-time signed link) ---
# Long random string used to sign download tokens (e.g. `openssl rand -base64 32`)
DOWNLOAD_SECRET=replace-with-a-long-random-string
# The installer to deliver. Use ONLY software you are licensed to distribute.
# Prefer a short-lived signed storage URL (e.g. a presigned S3 link).
DOWNLOAD_URL=https://your-storage.example.com/your-licensed-installer.msi

# --- Admin export (protects /api/admin/export) ---
# Long random string. Required to download submissions as CSV/XLSX/PDF.
ADMIN_TOKEN=replace-with-a-long-random-string

# --- Submissions database export (admin only) ---
# Secret required to download the CSV/XLSX/PDF export. Use a long random string.
ADMIN_TOKEN=replace-with-a-long-random-string

# --- Demo software login shown on the thank-you page (optional) ---
# Only put genuine *shareable demo / sandbox* credentials here. These are shown
# to everyone who completes the form, so NEVER put a live EFIN used for real
# e-filing here — sharing a live EFIN violates IRS e-file rules.
DEMO_EFIN=
DEMO_VALIDATION_CODE=
